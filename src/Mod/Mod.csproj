<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Vintage Story code mod: a thin adapter mapping the game API onto Core.
       References the game DLLs from the local install ($(VintageStoryPath), set in
       Directory.Build.props). Private=false so we don't copy the game's own DLLs into
       our build output. Shared build settings also come from Directory.Build.props. -->
  <PropertyGroup>
    <AssemblyName>Scribe</AssemblyName>
    <RootNamespace>Scribe</RootNamespace>
    <!-- The game loads the compiled DLL directly; no need to also produce a NuGet package. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="VintagestoryAPI">
      <HintPath>$(VintageStoryPath)/VintagestoryAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VintagestoryLib">
      <HintPath>$(VintageStoryPath)/VintagestoryLib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="protobuf-net">
      <HintPath>$(VintageStoryPath)/Lib/protobuf-net.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(VintageStoryPath)/Lib/Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- cairo-sharp: the 2D drawing library the game's own GUI system uses (the base
         GuiElement.ComposeElements(Context, ImageSurface) signature is Cairo types). A
         custom-drawn GUI element (ScribeRowElement, row-list-rework) inherently needs it. NOT a
         third-party/mod dependency - a game-runtime DLL shipped in the install, referenced like
         VintagestoryLib above (Private=false: the game provides it, we never copy it). -->
    <Reference Include="cairo-sharp">
      <HintPath>$(VintageStoryPath)/Lib/cairo-sharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- ConfigLib (modid `configlib`): OPTIONAL soft dependency (unify-row-sizing-libgui). Scribe
       calls no ConfigLib API; the integration is a no-code assets/scribe/config/configlib-patches.json
       manifest that ConfigLib discovers at startup and uses to expose the lectern's row-sizing floats
       in its in-game settings panel (reading/writing the same scribe-client-config.json the mod loads).
       No modinfo dependency: the manifest is simply unread when ConfigLib isn't installed, and the
       lectern works normally without it. No usable NuGet package exists; referenced against the DLL
       vendored under lib/ (see lib/README.md). Private=false: never copied into our output; the mod
       loader provides it if installed, same as the game DLLs above. -->
  <ItemGroup>
    <Reference Include="configlib">
      <HintPath>lib/configlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- LibGUI (modid `gui`): Scribe's first HARD mod dependency, gating the lectern GUI's
       migration off the native GuiComposer onto LibGUI's declarative widget tree
       (adopt-libgui-foundation; permitted by the live `gui-foundation-policy` spec because the
       explore-libgui-adoption spike cleared every make-or-break gate). Always required:
       players install the `gui` mod separately. No usable NuGet package exists; referenced
       against the DLLs vendored under lib/ (see lib/README.md for the source gui_2.0.0.zip
       and re-extraction steps).
       Private=false: never copy these into our own output; the installed `gui` mod provides them
       at runtime, same reasoning as the game DLLs above. Only Gui.dll is referenced for compile;
       the Svg/Skia/HarfBuzz companions resolve at runtime from the installed mod. -->
  <ItemGroup>
    <Reference Include="Gui">
      <HintPath>lib/Gui.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- LibGUI's public API surfaces OpenTK.Mathematics types (Vector2/Vector4). Resolve from
         the game's Lib/ like the other game DLLs (Private=false: the game provides it). -->
    <Reference Include="OpenTK.Mathematics">
      <HintPath>$(VintageStoryPath)/Lib/OpenTK.Mathematics.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- LibGUI's PaintingContext (touched by any custom RenderObject) surfaces SkiaSharp types
         (SKCanvas on .Canvas, SKShader on DrawBox's optional arg). The game ships SkiaSharp.dll in
         Lib/; resolve it there (Private=false: the game provides it). -->
    <Reference Include="SkiaSharp">
      <HintPath>$(VintageStoryPath)/Lib/SkiaSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- A Vintage Story mod is more than its DLL: modinfo.json and assets/ must sit alongside
       it (both when the game loads an unpacked mod folder and when Atlas stages this
       project's build output as a mod). Copy them into the build output on every build. -->
  <ItemGroup>
    <None Include="modinfo.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="assets/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
