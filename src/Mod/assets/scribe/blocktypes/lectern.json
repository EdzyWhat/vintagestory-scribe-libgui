{
	code: "scribelectern",
	class: "BlockScribeLectern",
	entityclass: "ScribeLectern",

	// Cloned from the vanilla open-lectern shape (game:block/clutter/bookshelves/lecturn-book-open)
	// into our own domain so its geometry and textures are editable without depending on vanilla
	// files. The shape's 4 embedded textures were repointed to scribe:block/lectern/* (clones of the
	// vanilla mahogany/ebony-ornate/normal-orangebrown/opened-normal PNGs) — edit those to reskin.
	shape: { base: "scribe:block/lectern/lectern" },

	creativeinventory: { "general": ["*"], "decorative": ["*"] },

	blockmaterial: "Wood",
	lightAbsorption: 0,
	sidesolid: { all: false },
	sideopaque: { all: false },
	faceCullMode: "NeverCull",
	replaceable: 500,
	resistance: 2,

	collisionbox: { x1: 0.1817, y1: 0, z1: 0.1875, x2: 0.8188, y2: 1.2563, z2: 0.8125 },
	selectionbox: { x1: 0.1817, y1: 0, z1: 0.1875, x2: 0.8188, y2: 1.2563, z2: 0.8125 },

	sounds: {
		place: "block/planks",
		hit: "block/planks",
		break: "block/planks",
		walk: "walk/wood"
	},

	guiTransform: {
		rotation: { x: -22.6, y: 142 },
		origin: { x: 0.5, y: 0.6, z: 0.5 },
		scale: 1
	},

	attributes: {
		handbook: {
			extraSections: [
				{
					title: "scribe:handbook-scribelectern-views-title",
					text: "scribe:handbook-scribelectern-views-text"
				},
				{
					title: "scribe:handbook-scribelectern-hud-title",
					text: "scribe:handbook-scribelectern-hud-text"
				}
			]
		}
	}
}
