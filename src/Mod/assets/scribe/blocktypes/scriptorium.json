{
	code: "scriptorium",
	class: "BlockScriptorium",
	entityclass: "Scriptorium",

	// DEDICATED MODEL (add-scriptorium-block design, Decision 2): now points at the combined Scriptorium
	// shape (table-long desk + open-book reading board + book stack + ink & quill), built from vanilla
	// clutter/item shapes and refined in VS Model Creator. This is a JSON-only swap — no code change. The
	// shape's own texture keys are the vanilla survival-domain paths; add per-key `textures` overrides here
	// if/when we want a bespoke Scribe atlas.
	shape: { base: "scribe:block/scriptorium/scriptorium" },

	// The combined shape pulls texture keys from four vanilla shapes (table-long, the bookshelves
	// lectern, a book pile, and the ink & quill). Blocks resolve shape texture keys from THIS dict at
	// render time (a shape's own embedded `textures` are editor-only for blocks), so every key must be
	// declared here or the model renders untextured. All paths are survival-domain vanilla textures;
	// swap to a bespoke Scribe atlas later without touching the shape. (Generated by build/gen-scriptorium-shape.py.)
	textures: {
		"charred": { base: "survival:block/wood/charred" },
		"ebony": { base: "survival:block/wood/debarked/mahogany" },
		"ebony-ornate": { base: "survival:block/wood/ebony-ornate" },
		"opened-normal": { base: "survival:item/lore/opened-normal" },
		"normal-brickred": { base: "survival:item/lore/normal-brickred" },
		"normal-brown": { base: "survival:item/lore/normal-brown" },
		"normal-lightbrown": { base: "survival:item/lore/normal-lightbrown" },
		"normal-olive": { base: "survival:item/lore/normal-olive" },
		"normal-orange": { base: "survival:item/lore/normal-orange" },
		"normal-orangebrown": { base: "survival:item/lore/normal-orangebrown" },
		"normal-purple": { base: "survival:item/lore/normal-purple" },
		"normal-purpleorange": { base: "survival:item/lore/normal-purpleorange" },
		"normal-slateblue": { base: "survival:item/lore/normal-slateblue" },
		"feather": { base: "survival:item/tool/feather" },
		"bituminous": { base: "survival:block/coal/bituminous" },
		"quartz": { base: "survival:block/glass/quartz" },
		"brass": { base: "survival:block/metal/ingot/silver" }
	},

