{
	code: "chalkboard",
	class: "BlockChalkboard",
	entityclass: "Chalkboard",

	// DEDICATED MODEL (add-scriptorium-block design, Decision 2): now points at the combined Scriptorium
	// shape (table-long desk + open-book reading board + book stack + ink & quill), built from vanilla
	// clutter/item shapes and refined in VS Model Creator. This is a JSON-only swap — no code change. The
	// shape's own texture keys are the vanilla survival-domain paths; add per-key `textures` overrides here
	// if/when we want a bespoke Scribe atlas.
	shape: { base: "scribe:block/chalkboard/chalkboard" },

	// The combined shape pulls texture keys from four vanilla shapes (table-long, the bookshelves
	// lectern, a book pile, and the ink & quill). Blocks resolve shape texture keys from THIS dict at
	// render time (a shape's own embedded `textures` are editor-only for blocks), so every key must be
	// declared here or the model renders untextured. All paths are survival-domain vanilla textures;
	// swap to a bespoke Scribe atlas later without touching the shape. (Generated by build/gen-scriptorium-shape.py.)
	textures: {
		"wood-h": { base: "scribe:block/chalkboard/wood-h" },
		"wood-v": { base: "scribe:block/chalkboard/wood-v" },
		"chalk": { base: "scribe:block/chalkboard/chalk" },
		"clate": { base: "scribe:block/chalkboard/slate" }
	},

	creativeinventory: { "general": ["*"], "decorative": ["*"] },

	blockmaterial: "Wood",
	lightAbsorption: 0,
	sidesolid: { all: false },
	sideopaque: { all: false },
	faceCullMode: "NeverCull",
	replaceable: 500,
	resistance: 2,

	collisionbox: { x1: 0.1817, y1: 0, z1: 0.1875, x2: 0.8188, y2: 1.2563, z2: 0.8125 },
	selectionbox: { x1: 0.1817, y1: 0, z1: 0.1875, x2: 0.8188, y2: 1.2563, z2: 0.8125 },

	sounds: {
		place: "block/planks",
