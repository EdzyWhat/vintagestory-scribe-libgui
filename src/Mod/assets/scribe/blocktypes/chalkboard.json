{
	code: "chalkboard",
	class: "BlockChalkboard",
	entityclass: "Chalkboard",

	// Wall-mounted like a vanilla painting (add-chalkboard-block D6): HorizontalAttachable picks the
	// -<side> variant from the clicked wall face and places it; the `side` variant group + shape
	// rotateYByType turn the board to face outward. The C# BlockScribeChalkboard opts out of the shared
	// writing-station's floor requirement + player-facing rotation so this behavior takes over.
	behaviors: [
		{ name: "HorizontalAttachable" }
	],

	variantgroups: [
		{ code: "side", loadFromProperties: "abstract/horizontalorientation" }
	],

	// The chalkboard's own model. The placed block renders through the block-entity's custom rotated-mesh
	// path (BlockEntityScribeChalkboard.WallMountAngleRad), which does NOT read this rotateYByType — so this
	// only orients the inventory/held/dropped item shape. Our shape's authored front is SOUTH (+Z) at 0°,
	// which is 180° from the vanilla painting convention (their art faces −Z), so the values are the mirror
	// of vanilla's: face the outward direction (opposite the `side`/attach direction). Kept in sync with the
	// block-entity angle mapping.
	shapebytype: {
		"*": {
			base: "scribe:block/chalkboard/chalkboard",
			rotateYByType: { "*-north": 0, "*-east": 270, "*-south": 180, "*-west": 90 }
		}
	},

	// Every texture KEY the shape's faces reference must be declared here or that face renders untextured.
	// The model was collapsed onto its four authored chalkboard textures (chalk / slate / wood-h / wood-v);
	// all 33 faces reference one of these, so the inherited clutter keys (material / lining / glass /
	// material-deco / material-grid) that once needed placeholder mappings are gone — no face uses them.
	// (Committed art lives under textures/block/blackboard/, not .../chalkboard/.)
	textures: {
		"chalk": { base: "scribe:block/blackboard/chalk" },
		"slate": { base: "scribe:block/blackboard/slate" },
		"wood-h": { base: "scribe:block/blackboard/wood-h" },
		"wood-v": { base: "scribe:block/blackboard/wood-v" }
	},

	creativeinventory: { "general": ["chalkboard-north"], "decorative": ["chalkboard-north"] },

	blockmaterial: "Wood",
	lightAbsorption: 0,
	sidesolid: { all: false },
	sideopaque: { all: false },
	sideao: { all: false },
	faceCullMode: "NeverCull",
	replaceable: 5001,
	resistance: 2,
	rainPermeable: true,
	materialDensity: 600,

	// Painting-style: no collision (walk-through), and a thin selection SLAB bounded to the board instead of
	// a full-cell cube. This box is authored for the angle-0 (north) facing — board against the −Z wall — and
	// the block-entity rotates it to the placed facing via MeshAngleRad (BlockEntityScribeWritingStation.
	// RotatedSelectionBox), so it needs NO rotateYByType (that would double-rotate). Depth 0..0.2 covers the
	// frame + chalk tray; full width/height so the whole board face is clickable.
	collisionbox: null,
	selectionbox: { x1: 0, y1: 0, z1: 0, x2: 1, y2: 1, z2: 0.2 },

	sounds: {
		place: "block/planks",
		hit: "block/planks",
		break: "block/planks",
		walk: "walk/wood"
	},

	guiTransform: {
		rotation: { x: -22.6, y: 25, z: 0 },
		origin: { x: 0.5, y: 0.5, z: 0 },
		scale: 1.2
	},
	groundTransform: {
		translation: { x: 0, y: 0, z: 0 },
		rotation: { x: -90, y: 0, z: 0 },
		origin: { x: 0.5, y: 0, z: 0 },
		scale: 2.5
	},
	tpHandTransform: {
		translation: { x: -1, y: -0.29, z: 0.05 },
		rotation: { x: 3, y: 12, z: -25 },
		origin: { x: 0.5, y: 0.5, z: 0 },
		scale: 0.6
	},

	attributes: {
		handbook: {
			extraSections: [
				{
					title: "scribe:handbook-chalkboard-about-title",
					text: "scribe:handbook-chalkboard-about-text"
				},
				{
					title: "scribe:handbook-scribe-hud-ref-title",
					text: "scribe:handbook-scribe-hud-ref-text"
				}
			]
		}
	}
}
