<Project Sdk="Microsoft.NET.Sdk">

  <!-- Atlas integration tests: boot a real headless server against the local Vintage Story
       install (VINTAGE_STORY env var) and exercise the Mod's server-side behavior
       (persistence, the network edit round-trip, the single-editor lock). LOCAL ONLY:
       cloud CI has no game install, so this project is not part of ci.yml. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Where the installed Vintage Story mods live, so the hard `gui` (LibGUI) dependency can be
       staged for Atlas (see the gui-staging ItemGroup below). Defaults to the macOS install path
       this project already assumes for extracting src/Mod/lib/ (see src/Mod/lib/README.md);
       override on another OS with -p:VintagestoryDataMods=... . LOCAL ONLY, like the whole suite. -->
  <PropertyGroup>
    <VintagestoryDataMods Condition="'$(VintagestoryDataMods)' == ''">$(HOME)/Library/Application Support/VintagestoryData/Mods</VintagestoryDataMods>
    <ScribeGuiModZip>$(VintagestoryDataMods)/gui_2.0.0.zip</ScribeGuiModZip>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Pixnop.Atlas.XUnit" Version="0.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Game types appear directly in IWorldSession signatures (BlockPos and friends),
         so the test project must compile against them too. -->
    <Reference Include="VintagestoryAPI">
      <HintPath>$(VintageStoryPath)/VintagestoryAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- AtlasMod=true triggers Atlas's own buildTransitive target, which resolves this
         reference's build output and writes it to atlas-mods.generated.txt next to the
         test assembly, no hand-written relative path needed. -->
    <ProjectReference Include="..\..\src\Mod\Mod.csproj">
      <AtlasMod>true</AtlasMod>
    </ProjectReference>
  </ItemGroup>

  <!-- World fixtures (.vcdbs), regenerated with `atlas fixture` when a builder scenario
       changes (see README's "Running the Atlas suite" section). Paths in [AtlasWorld] and
       the fixture command's out option are resolved relative to THIS output directory,
       not the source tree, so the fixture must be copied here on every build. -->
  <ItemGroup>
    <None Include="fixtures/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Stage the hard `gui` (LibGUI) dependency for Atlas. Atlas boots the headless server with
       ONLY the staged mods on its mod path (the mod-under-test from atlas-mods.generated.txt plus
       whatever [assembly: AtlasMods(...)] declares) - it does NOT see the player's installed Mods
       folder. Without gui, scribe's `gui@2.0.0` dependency is unresolved, the mod loader skips
       scribe, and every scenario fails at SetBlock("scribe:scribelectern") with "Unknown block
       code". The installed gui zip is client-side (requiredOnServer:false) but the server's
       dependency resolver still needs it present. We copy the installed zip into the test output
       dir and reference it by the resulting relative name in AssemblyInfo.cs's [assembly:
       AtlasMods("gui_2.0.0.zip")] (AtlasMods paths resolve against the test assembly's dir). -->
  <ItemGroup Condition="Exists('$(ScribeGuiModZip)')">
    <None Include="$(ScribeGuiModZip)" CopyToOutputDirectory="PreserveNewest" Link="gui_2.0.0.zip" />
  </ItemGroup>
  <Target Name="WarnMissingGuiMod" BeforeTargets="Build" Condition="!Exists('$(ScribeGuiModZip)')">
    <Warning Text="gui mod zip not found at '$(ScribeGuiModZip)'. Atlas cannot stage scribe's hard `gui` dependency, so every integration scenario will fail at SetBlock with 'Unknown block code scribe:scribelectern'. Install the `gui` (LibGUI) mod, or set -p:VintagestoryDataMods=&lt;your Mods folder&gt;." />
  </Target>

</Project>
